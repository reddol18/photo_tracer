# 평가용 가족 사진·결과물은 저장소에 올리지 않는다
eval_data/
*.jpg
*.jpeg
*.png
*.heic
# 앱 아이콘 등 리소스 이미지는 저장소에 둔다
!bench_app/android/app/src/main/res/**/*.png
!app/android/app/src/main/res/**/*.png
# README 화면 그림: 예시 데이터로 그린 것만(app/test/readme_screens_test.dart). 폰 캡처는 넣지 않는다
!docs/screens/*.png
# 런처 아이콘 원본 카드·플레이 스토어 512 아이콘 (사용자가 만든 그림)
!docs/icon/*.png

# 모델 가중치 (다운로드 스크립트로 받음)
models/
*.onnx
*.tflite
# 미니 앱 assets(모델·토크나이저·확인용 검색어)는 poc/app_assets.py build 로 만든다
app/android/app/src/main/assets/

# Python
__pycache__/
.venv/

# Flutter / Android
build/
.dart_tool/
.gradle/
local.properties
*.iml
.idea/
