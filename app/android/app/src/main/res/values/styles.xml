<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 시작 화면(#21), 다크 모드가 꺼져 있을 때. Android 11 이하는 이 windowBackground(그라데이션 + 가운데 아이콘)가 보이고,
         12 이상은 values-v31의 windowSplashScreen*이 보인다. Flutter가 첫 프레임을 그리면 사라진다 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Flutter 화면 뒤 창 배경. 시작 화면 가운데 색과 같게 해 흰 화면이 번쩍이지 않게 한다 -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_mid</item>
    </style>
</resources>
