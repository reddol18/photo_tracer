<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 13 이상 시스템 시작 화면(#21), 어둡게. 색은 values-night/colors.xml -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_mid</item>
        <item name="android:windowSplashScreenBackground">@color/splash_mid</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_inset</item>
        <!-- 13+: 런처가 아닌 곳(알림·adb am start·다른 앱)에서 켜도 단색만이 아니라 아이콘까지 보이게 -->
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_mid</item>
    </style>
</resources>
